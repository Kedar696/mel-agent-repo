# Copy to .env (never commit). The Bedrock writer is off unless MEL_USE_LLM=1 and the model are set.
# AWS keys come from ~/.aws/credentials (the event's temporary keys), never from this file.
MEL_USE_LLM=0
MEL_BEDROCK_REGION=us-west-2
MEL_BEDROCK_WRITE_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
MEL_JUDGE_MODEL=google.gemma-3-12b-it
# Send-window rule (P2): brief (default) or answer_key. See mel/timing/README.md.
MEL_TIMING_BASIS=brief
# Point at the full pack instead of data/mock (the pack is committed in this repo):
# MEL_DATA_DIR=mel-survey-agent-participant-pack/participant-pack/data
# Write run output here instead of ./out. Keep it OUT of OneDrive/Dropbox folders.
# MEL_OUT_DIR=/tmp/mel_out
# Optional: read the Voice-channel preview aloud in the app (ElevenLabs text to speech; a key with
# Text to Speech access is enough). Never commit the key.
# On the hosted copy (ECS Express Mode) pass it to the container as a secret; never bake it into the image.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# REST API (mel/api): the bearer token every call but /healthz must send (the API does not start without it),
# and the database. Amazon RDS for PostgreSQL in production; a local SQLite file by default.
MEL_API_TOKEN=
# MEL_DATABASE_URL=postgresql://mel:password@host:5432/mel
